                  "type": "text",
                  "id": "AW5ul",
                  "name": "para2",
                  "fill": "$--text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Memory systems in artificial intelligence have evolved significantly over the past decade. From simple key-value stores to sophisticated neural memory networks, the landscape continues to expand with innovative approaches.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
