                  "children": [
                    {
                      "type": "text",
                      "id": "n6srn3",
                      "name": "Code Line",
                      "fill": "#E7E5E4",
                      "content": "let count = $state(0);",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "PF0sp",
                      "name": "Code Line",
                      "fill": "#E7E5E4",
                      "content": "let doubled = $derived(count * 2);",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
