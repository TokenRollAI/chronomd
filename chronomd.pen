                  "type": "text",
                  "id": "kQyEu",
                  "name": "H2",
                  "fill": "$v2-ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "从 $: 到 $derived",
                  "fontFamily": "Newsreader",
                  "fontSize": 24,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "JuRmg",
                  "fill": "$v2-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "过去用 $: 声明的派生值，现在统一使用 $derived。好处是依赖关系更清晰，也不再需要担心语句顺序。",
                  "lineHeight": 1.85,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "VfQIz",
                  "name": "Code Block",
                  "width": "fill_container",
